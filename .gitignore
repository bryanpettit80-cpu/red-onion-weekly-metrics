.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
debug.log

# Known local test/debug workspaces. Preserve their contents until cleanup is approved.
/.pytest-tmp/
/_program/.debug-usability/
/_program/.pytest-usability-contract/
/_program/.pytest-usability-one/
/_program/.test-tmp-model-validation/

# Excel source data, generated workbooks, and archives are business data, not source code.
*.xls
*.xlsx
*.lnk
~$*.xlsx

# Runtime folders are outside the deployed automation repository. Ignore local
# standalone copies when the repository is used outside Dropbox.
01 Daily Reports - Drop Here/*
02 Finished Reports/*
03 Archive/*

# Legacy local layouts remain ignored until an operator workspace is migrated.
Daily Reports/*
Output/*
Archive - Old Files/*
