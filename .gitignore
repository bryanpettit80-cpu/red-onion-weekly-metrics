.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
debug.log

# Excel source data, generated workbooks, and archives are business data, not source code.
*.xls
*.xlsx
*.lnk
~$*.xlsx

# Keep the standard workflow folders in GitHub, but ignore their contents.
Daily Reports/*
!Daily Reports/.gitkeep
Output/*
!Output/.gitkeep
Archive - Old Files/*
!Archive - Old Files/.gitkeep
